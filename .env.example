# Public frontend configuration. These values are visible in the built JavaScript.
# Restrict the YouTube key in Google Cloud Console to YouTube Data API v3 and
# to the specific website referrers/domains used by the app.
VITE_YOUTUBE_API_KEY=

# Spotify Client ID is public. Do NOT put a Spotify client secret in frontend env.
# Configure Spotify Authorization Code with PKCE and register the app origin/path
# (for example https://your-domain.example/) as an allowed Redirect URI.
VITE_SPOTIFY_CLIENT_ID=
